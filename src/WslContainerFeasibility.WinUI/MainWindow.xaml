<Window
    x:Class="WslContainerFeasibility.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WSL container feasibility">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="WSL container feasibility" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Run a fixed, non-sensitive Linux fixture after checking its container boundaries."
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="CheckButton"
                    AutomationProperties.AutomationId="CheckPrerequisitesButton"
                    Content="Check prerequisites"
                    Click="CheckButton_Click" />
                <Button
                    x:Name="RunButton"
                    AutomationProperties.AutomationId="RunFixtureButton"
                    Content="Run fixture"
                    Click="RunButton_Click" />
                <Button
                    x:Name="CancelButton"
                    AutomationProperties.AutomationId="CancelFixtureButton"
                    Content="Cancel"
                    IsEnabled="False"
                    Click="CancelButton_Click" />
            </StackPanel>
            <TextBlock Text="Prerequisites" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="PrerequisiteText"
                AutomationProperties.AutomationId="PrerequisiteStatus"
                AutomationProperties.LiveSetting="Polite"
                Text="Not checked. Running the fixture also checks prerequisites."
                TextWrapping="Wrap" />
            <TextBlock Text="Outcome" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="OutcomeText"
                AutomationProperties.AutomationId="FixtureOutcome"
                AutomationProperties.LiveSetting="Polite"
                Text="Not run." />
            <TextBlock
                x:Name="StatusText"
                AutomationProperties.AutomationId="FixtureStatus"
                AutomationProperties.LiveSetting="Polite"
                Text="No container has been started."
                TextWrapping="Wrap" />
            <TextBlock Text="Evidence" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="EvidenceText"
                AutomationProperties.AutomationId="EvidencePath"
                Text="No evidence saved yet."
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True" />
            <TextBlock Text="One isolated Copilot attempt" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="Sign in with the official Copilot CLI, then select an available strategy. A confirmation is required before the one potentially billable attempt."
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="SignInButton"
                    AutomationProperties.AutomationId="CopilotSignInButton"
                    Content="Sign in with Copilot CLI"
                    Click="SignInButton_Click" />
                <Button
                    x:Name="LoadStrategiesButton"
                    AutomationProperties.AutomationId="LoadCopilotStrategiesButton"
                    Content="Load strategies"
                    Click="LoadStrategiesButton_Click" />
                <ComboBox
                    x:Name="StrategyComboBox"
                    AutomationProperties.AutomationId="CopilotStrategyPicker"
                    PlaceholderText="Select a strategy"
                    MinWidth="320"
                    SelectionChanged="StrategyComboBox_SelectionChanged" />
                <Button
                    x:Name="RunCopilotButton"
                    AutomationProperties.AutomationId="RunCopilotAttemptButton"
                    Content="Run Copilot attempt"
                    IsEnabled="False"
                    Click="RunCopilotButton_Click" />
            </StackPanel>
            <TextBlock Text="Copilot outcome" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="CopilotOutcomeText"
                AutomationProperties.AutomationId="CopilotRunOutcome"
                AutomationProperties.LiveSetting="Polite"
                Text="Not run." />
            <TextBlock
                x:Name="CopilotStatusText"
                AutomationProperties.AutomationId="CopilotRunStatus"
                AutomationProperties.LiveSetting="Polite"
                Text="No Copilot request has been sent."
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="CopilotEvidenceText"
                AutomationProperties.AutomationId="CopilotEvidencePath"
                Text="No Copilot evidence saved yet."
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True" />
            <TextBox
                x:Name="CopilotPatchText"
                AutomationProperties.AutomationId="CopilotRunPatch"
                Header="Captured change"
                IsReadOnly="True"
                IsTabStop="True"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="120" />
        </StackPanel>
    </ScrollViewer>
</Window>
